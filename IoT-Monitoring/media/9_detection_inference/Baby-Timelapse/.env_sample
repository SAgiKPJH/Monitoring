# ── Baby-Timelapse 설정 템플릿 ──
#   사용법:  cp .env_sample .env   후 값 채우기 (.env 는 커밋 금지)
#   로컬 실행: capture.py 가 이 폴더의 .env 를 읽음
#   도커 실행: docker-compose.yml 의 env_file 로 주입됨

# 스트림 (go2rtc)
STREAM_URL=

# 감지
CONF=0.8              # baby 채택 임계 (Threshold)
BABY_CLASS=0          # 0=baby, 1=baby_face

# 스케줄 (적응형)
SUCCESS_INTERVAL_SEC=3600   # 저장 성공 후 대기(1시간)
RETRY_INTERVAL_SEC=600      # 아기 없을 때 재시도(10분)

# 저장 (상대경로 스테이징) / 전송 후 삭제
OUT_DIR=captures
KEEP_LOCAL=0          # 전송 성공 시 로컬 삭제(1=유지)

# ── SCP 원격 전송 (전송 경로) ──
SCP_TARGET=   # user@IP:/원격/경로/  (홈경로 확인!)
SCP_PORT=22
SCP_LEGACY=1          # -O 레거시 SCP(SFTP subsystem 없는 서버). SFTP-only 면 0
# SCP_KEY=/keys/id_rsa   # 도커 마운트 키 경로. 로컬은 비우면 기본 SSH 키 사용

# ── 테스트용 (운영에선 주석/0) ──
# RUN_ONCE=1          # 1회만 캡처 후 종료
# FORCE_SAVE=1        # 감지 없어도 강제 저장/전송(전송 경로 점검용)
