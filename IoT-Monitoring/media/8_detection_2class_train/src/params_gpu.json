    "train_ratio": 0.8,
    "optimizer": "adam",
    "lr": 0.001,
    "using_amp": false,
    "using_gpu": true,
    "validation_save_random": false,
    "normalize_mean": 0.0,
    "normalize_stdev": 1.0,
    "criterion": "CrossEntropyLoss",
    "loss_eps": 0,
    "conf_thres": 0.35,
    "iou_thres": 0.5,
    "weight_decay": 0.0005,
    "augmentation": {
      "horizontal_flip": true,
      "vertical_flip": true,
      "brightness": 0.3,
      "contrast": 0.3,
      "noise": 0.03
    }
  }
}