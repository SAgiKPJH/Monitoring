# ── 15_rdk_x5_runtime 설정 템플릿 ──  cp .env_sample .env 후 값 채우기 (.env 는 커밋 금지)

# go2rtc에서 ffmpeg를 붙여 http://172.30.1.42:1984/api/stream.mjpeg?src=camera1에 동작하게 가능
# 또. fps·해상도를 낮추거나 저해상도 서브스트림 src 를 지정 가능.
STREAM_URL=http://172.30.1.42:1984/stream.html?src=camera1

# 추론 백엔드: 비우면 자동(보드에 hobot_dnn 있으면 bpu, 아니면 torch). 명시: torch(PC, models/*.pth·.pt) | bpu(RDK X5 NPU, models/*.bin)
BACKEND=

# (BPU) pyeasy_dnn 투입 형식. 기본 nchw_i8 = RDK X5 OE1.2.8 실측 정답(속성은 NHWC/uint8 로 보고되지만 NCHW int8 이어야 점수가 나옴).
# 다른 보드/OE 버전에서 감지가 0 이면 bpu_input_probe.py 로 확인 후 변경: nchw_i8 | nchw_u8 | nhwc_u8 | nhwc_i8 | nv12
BPU_INPUT=

# ── 알람 채널 (미설정 시 콘솔 출력만) ──
SLACK_WEBHOOK=                                   # https://hooks.slack.com/services/...  (텍스트, 이미지는 로컬 저장)
GRAFANA_URL=https://ajusoft.net/grafana          # IoT-Monitoring\.env 참고
GRAFANA_TOKEN=                                    # Grafana API/서비스계정 토큰(annotations 쓰기)
ALARM_COOLDOWN=300                               # 동일 알람 최소 간격(초) = 5분
