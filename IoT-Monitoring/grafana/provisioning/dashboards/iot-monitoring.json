          "url": "http://api:8080/api/readings/latest?deviceId=${deviceId}",
          "url_options": { "method": "GET" },
          "root_selector": "",
          "columns": [
            { "selector": "temperature", "text": "temperature", "type": "number" },
            { "selector": "humidity", "text": "humidity", "type": "number" },
            { "selector": "light", "text": "light", "type": "number" },
