          "format": "timeseries",
          "parser": "backend",
          "url": "http://api:8080/api/readings?deviceId=${deviceId}&from=${__from:date:iso}&to=${__to:date:iso}&limit=5000",
          "url_options": { "method": "GET" },
          "root_selector": "",
          "columns": [
            { "selector": "timestamp", "text": "time", "type": "timestamp" },
