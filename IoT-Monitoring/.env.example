# Copy to ".env" and adjust as needed:  cp .env.example .env

# ---- MongoDB ----
MONGO_ROOT_USERNAME=~~~
MONGO_ROOT_PASSWORD=~~~
MONGO_DB=~~~
MONGO_APP_USERNAME=~~~
MONGO_APP_PASSWORD=~~~
MONGO_PORT=~~~

# ---- ASP.NET Core API ----
API_PORT=~~~
# Leave empty to disable auth. If set, the ESP8266 must send the same value in the X-Api-Key header.
API_KEY=~~~

# ---- Grafana ----
GRAFANA_USER=~~~
GRAFANA_PASSWORD=~~~
GRAFANA_PORT=~~~
# 로그인 유지: 미접속 이 기간 지나면 로그아웃 / 최대 유지 기간 (예: 12h, 7d, 30d, 90d)
GRAFANA_SESSION_IDLE=30d
GRAFANA_SESSION_MAX=90d
# Grafana 와 Infinity 는 짝을 맞출 것 (12.3+ ↔ 3.11.2+ / 11.6~12.2 ↔ 3.11.1 이하)
GRAFANA_VERSION=13.1.2
INFINITY_PLUGIN_VERSION=3.11.2 # 비우면 플러그인도 최신
# 리버스 프록시 뒤 서브패스로 서비스할 때 (예: https://example.com/grafana/)
#   ROOT_URL 은 외부에서 보이는 전체 주소 + 끝에 슬래시 필수
GRAFANA_ROOT_URL=https://ajusoft.net/grafana/
GRAFANA_SUBPATH=true

# ---- mongo-express (optional admin UI) ----
MONGO_EXPRESS_PORT=~~~
ME_USER=~~~
ME_PASSWORD=~~~

# ---- Camera (go2rtc / Tuya) ----
GO2RTC_PORT=1984
# Auto-restart go2rtc every N seconds (its Tuya cloud stream degrades after ~3 days).
# Default 172800 = 2 days. Set 0-length to disable only by removing the restarter service.
GO2RTC_RESTART_SECONDS=172800
TUYA_EMAIL=~~~
# Tuya Smart 비밀번호 — URL 쿼리에 들어가므로 특수문자는 URL 인코딩!
#   &->%26  %->%25  #->%23  +->%2B  (원문: dkFn12-Sagi13K& → & 를 %26 으로)
TUYA_PASSWORD=~~~
TUYA_DEVICE_ID=~~~
# CAMERA_IP: Tuya 클라우드 스트림엔 미사용(로컬 RTSP 참고값)
CAMERA_IP=~~~

# ---- Slack 알림 (Grafana 네이티브 incoming webhook) ----
# Slack 앱 → Incoming Webhooks 활성화 → 채널용 Webhook URL 발급 → 실제 값은 .env 에만.
SLACK_WEBHOOK_URL=

