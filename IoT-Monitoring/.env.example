# Copy to ".env" and adjust as needed:  cp .env.example .env

# ---- MongoDB ----
MONGO_ROOT_USERNAME=~~~
MONGO_ROOT_PASSWORD=~~~
MONGO_DB=~~~
MONGO_APP_USERNAME=~~~
MONGO_APP_PASSWORD=~~~
MONGO_PORT=~~~

# ---- ASP.NET Core API ----
API_PORT=~~~
# Leave empty to disable auth. If set, the ESP8266 must send the same value in the X-Api-Key header.
API_KEY=~~~

# ---- Grafana ----
GRAFANA_USER=~~~
GRAFANA_PASSWORD=~~~
GRAFANA_PORT=~~~

# ---- mongo-express (optional admin UI) ----
MONGO_EXPRESS_PORT=~~~
ME_USER=~~~
ME_PASSWORD=~~~

# ---- Camera (go2rtc / Tuya) ----
GO2RTC_PORT=1984
# Auto-restart go2rtc every N seconds (its Tuya cloud stream degrades after ~3 days).
# Default 172800 = 2 days. Set 0-length to disable only by removing the restarter service.
GO2RTC_RESTART_SECONDS=172800
TUYA_EMAIL=~~~
# Tuya Smart 비밀번호 — URL 쿼리에 들어가므로 특수문자는 URL 인코딩!
#   &->%26  %->%25  #->%23  +->%2B  (원문: dkFn12-Sagi13K& → & 를 %26 으로)
TUYA_PASSWORD=~~~
TUYA_DEVICE_ID=~~~
# CAMERA_IP: Tuya 클라우드 스트림엔 미사용(로컬 RTSP 참고값)
CAMERA_IP=~~~

# ---- Slack 알림 (Grafana 네이티브 incoming webhook) ----
# Slack 앱 → Incoming Webhooks 활성화 → 채널용 Webhook URL 발급 → 실제 값은 .env 에만.
SLACK_WEBHOOK_URL=

