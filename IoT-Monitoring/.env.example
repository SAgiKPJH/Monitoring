# Copy to ".env" and adjust as needed:  cp .env.example .env

# ---- MongoDB ----
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=rootpass
MONGO_DB=monitoring
MONGO_APP_USERNAME=iot
MONGO_APP_PASSWORD=iotpass
MONGO_PORT=27017

# ---- ASP.NET Core API ----
API_PORT=8080
# Leave empty to disable auth. If set, the ESP8266 must send the same value in the X-Api-Key header.
API_KEY=test_monitoring

# ---- Grafana ----
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
GRAFANA_PORT=3000

# ---- mongo-express (optional admin UI) ----
MONGO_EXPRESS_PORT=8081
ME_USER=admin
ME_PASSWORD=admin
