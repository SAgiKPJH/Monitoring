[Unit]
Description=RDK X5 NRF24L01 receiver (ROS 2)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sunrise
# ↓↓↓ run.sh 의 실제 절대경로로 수정하세요 (이 파일이 있는 위치의 run.sh) ↓↓↓
ExecStart=/home/sunrise/JJU/Receiver/ros2_ws/run.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
